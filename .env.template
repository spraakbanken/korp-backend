# The absolute paths to the CQP binaries (cqp and cwb-scan-corpus)
CQP_EXECUTABLE = ""
CWB_SCAN_EXECUTABLE = ""

# The absolute path to the CWB registry directory
CWB_REGISTRY = ""

# The default encoding for the cqp binary
CQP_ENCODING = "UTF-8"

# Locale to use when sorting
LC_COLLATE = "sv_SE.UTF-8"

# The maximum number of search results that can be returned per query (0 = no limit)
MAX_KWIC_ROWS = 0

# Number of threads to use during parallel processing
PARALLEL_THREADS = 1

# Database host and port
DB_HOST = "localhost"
DB_PORT = 3306

# Database name
DB_NAME = ""
DB_CHARSET = "utf8mb4"

# Word Picture table prefix
DB_WP_TABLE = "relations"

# Username and password for database access
DB_USER = ""
DB_PASSWORD = ""

# Cache directory path (optional). Script must have read and write access.
CACHE_DIR = ""

# Disk cache lifespan in minutes
CACHE_LIFESPAN = 20

# Memcached server IP address and port
MEMCACHED_SERVER = ""

# Enable route-specific rate limiting (requires Korp to be installed with the `rate-limiting` extra dependencies)
RATE_LIMIT_ENABLED = False

# Optional explicit storage URI for rate limiting (defaults to async+memcached://<MEMCACHED_SERVER>)
RATE_LIMIT_STORAGE_URI = ""

# When to include rate limit headers in responses (`none`, `on_reject`, `always`)
RATE_LIMIT_HEADERS = "on_reject"

# Default rate limit applied to all rate-limited routes (marked with `@api_handler(rate_limit=True)`). Uses `limits`
# syntax, e.g. "10/minute" or "1/second;60/minute". Empty string means no limit.
RATE_LIMIT_DEFAULT = ""

# Per-route rate limit overrides as JSON dict (e.g. '{"query": "30/minute"}'). Overrides RATE_LIMIT_DEFAULT
# for matched routes. Empty value disables rate limiting for that route.
RATE_LIMITS = {}

# Max number of rows from count command to cache
CACHE_MAX_STATS = 50

# Max size in bytes per cached query data file (0 = no limit)
CACHE_MAX_QUERY_DATA = 0

# Corpus configuration directory
CORPUS_CONFIG_DIR = ""

# Set to True to enable "lab mode", potentially enabling experimental features and access to lab-only corpora
LAB_MODE = False

# Plugins to load
PLUGINS = ["plugins.example"]

# Plugin configuration file
PLUGINS_CONFIG_FILE = "plugins.yaml"

# Optional inline plugin configuration overrides
PLUGINS_CONFIG = {}
